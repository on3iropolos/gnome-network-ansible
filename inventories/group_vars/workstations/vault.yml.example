---
# Copy this file to group_vars/workstations/vault.yml and fill in your secrets:
# cp group_vars/workstations/vault.yml.example group_vars/workstations/vault.yml
# ansible-vault edit group_vars/workstations/vault.yml

vault_hostname: "workstation"
vault_user_name: "johndoe"
vault_user_password: "supersecretpassword"
vault_user_ssh_key: "ssh-rsa AAAA... user@example.com"
vault_git_user_name: "John Doe"
vault_git_user_email: "john.doe@example.com"
vault_encryption_password: ""

# SSH Identities
# Note: All keys will be added to GNOME Keyring for automatic unlock on login
vault_user_ssh_identities: []
# Example:
# vault_user_ssh_identities:
#   - name: github
#     filename: github-ssh
#     private_key: ""
#     public_key: ""
#     host: github.com
