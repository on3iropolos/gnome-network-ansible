apiVersion: v1
kind: Service
metadata:
  name: hindsight
  namespace: {{ hindsight_namespace }}
  labels:
    app: hindsight
spec:
  type: LoadBalancer
  selector:
    app: hindsight
  ports:
    - name: api
      port: 8888
      targetPort: 8888
      protocol: TCP
    - name: control-plane
      port: 9999
      targetPort: 9999
      protocol: TCP
