# Environment Variables for Ansible Playbooks
# Copy this file to .env and set your actual values
# DO NOT commit .env to version control

# =============================================================================
# REQUIRED VARIABLES
# =============================================================================

# User account password (used during installation and provisioning)
USER_PASSWORD=your_secure_password_here

# LUKS encryption password (required if encryption is enabled)
ENCRYPTION_PASSWORD=your_encryption_password_here

# SSH public key for remote access to the installed system
# Generate with: ssh-keygen -t ed25519 -C "your_email@example.com"
USER_SSH_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... your_email@example.com"

# =============================================================================
# OPTIONAL VARIABLES (Git Configuration)
# =============================================================================

# Git global user.name (defaults to 'username' if not set)
GIT_USER_NAME="Your Name"

# Git global user.email (defaults to 'user@example.com' if not set)
GIT_USER_EMAIL="your.email@example.com"

# =============================================================================
# OPTIONAL VARIABLES (SSH Client Identities)
# =============================================================================

# GitHub SSH private key (for git clone via SSH)
# Load from file: export GITHUB_SSH_PRIVATE_KEY="$(cat ~/.ssh/github_key)"
GITHUB_SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
...your private key content...
-----END OPENSSH PRIVATE KEY-----"

# GitHub SSH public key (for git clone via SSH)
# Load from file: export GITHUB_SSH_PUBLIC_KEY="$(cat ~/.ssh/github_key.pub)"
GITHUB_SSH_PUBLIC_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... your_email@example.com"

# =============================================================================
# DOCKER DEVELOPMENT (docker-compose.yml)
# =============================================================================

# Legacy variable for Packer/Docker development
SSH_PASSWORD=your_ssh_password_here

# Note: Update the SSH key path in docker-compose.yml if using a different key
# Default: ${HOME}/.ssh/github_ssh_key.pub