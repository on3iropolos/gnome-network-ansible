# Environment variables for Ansible playbooks
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control (it's in .gitignore)

# SSH password for connecting to managed hosts (e.g., root password for VMs)
SSH_PASSWORD=your_ssh_password_here

# Password for encrypted volumes (if using arch_iso_install role)
ENCRYPTION_PASSWORD=your_encryption_password_here

# User password for creating user accounts (will be set on new systems)
USER_PASSWORD=your_user_password_here

# IMPORTANT: SSH Public Key Configuration
# The docker-compose.yml mounts your SSH public key from:
#   ${HOME}/.ssh/git_on3iropolos_ed25519.pub -> /root/.ssh/user_public_key.pub
# 
# If you need to use a different public key:
# 1. Update the volume mount in docker-compose.yml
# 2. Update pub_key_location in your host_vars file
# 
# This architecture mounts ONLY the public key (not your entire .ssh directory)
# to maintain security and avoid permission conflicts.