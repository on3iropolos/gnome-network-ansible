# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform crash log files
crash.log
crash.*.log

# Terraform directory
.terraform/
.terraform.lock.hcl

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Variable files that might contain sensitive data
*.auto.tfvars
*.auto.tfvars.json

# Ignore any local testing files
test-*.tfvars
local-*.tfvars